# AI API Relay deployment environment
# Copy this file to .env, edit values, then protect it with: chmod 600 .env
# Never commit .env. Values containing change-me/your-* are placeholders.

# -----------------------------------------------------------------------------
# Deployment mode and public entry points
# -----------------------------------------------------------------------------
DEPLOYMENT_MODE=ip
SERVER_PUBLIC_IP=89.167.21.176
SUB2API_DOMAIN=sub2api.your-domain.com
NEW_API_DOMAIN=newapi.your-domain.com

COMPOSE_PROJECT_NAME=ai-api-relay
TZ=Asia/Hong_Kong

# -----------------------------------------------------------------------------
# Pinned container image tags. Review and update intentionally.
# -----------------------------------------------------------------------------
POSTGRES_IMAGE_TAG=16.10-alpine
REDIS_IMAGE_TAG=7.4.5-alpine
NGINX_IMAGE_TAG=1.29.1-alpine
CERTBOT_IMAGE_TAG=v5.4.0
# Pin the reviewed upstream release; do not use latest.
SUB2API_IMAGE_TAG=change-me-pin-sub2api-tag
# Upstream v1.0.0-rc.38 notes require reconfiguring all video model prices when
# upgrading from rc.26 or earlier and state that the release is not recommended
# for production. Review video pricing after upgrades from older versions.
NEW_API_IMAGE_TAG=v1.0.0-rc.40

# -----------------------------------------------------------------------------
# Resource limits for a 4 GB VPS
# -----------------------------------------------------------------------------
POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=320m
SUB2API_MEM_LIMIT=768m
NEW_API_MEM_LIMIT=768m
NGINX_MEM_LIMIT=128m
CERTBOT_MEM_LIMIT=128m

POSTGRES_CPUS=1.0
REDIS_CPUS=0.5
SUB2API_CPUS=1.0
NEW_API_CPUS=1.0
NGINX_CPUS=0.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# PostgreSQL. Separate application databases and users are required.
# -----------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser-password

SUB2API_POSTGRES_DB=sub2api
SUB2API_POSTGRES_USER=sub2api
SUB2API_POSTGRES_PASSWORD=change-me-sub2api-postgres-password

NEW_API_POSTGRES_DB=newapi
NEW_API_POSTGRES_USER=newapi
NEW_API_POSTGRES_PASSWORD=change-me-newapi-postgres-password

# -----------------------------------------------------------------------------
# Redis. DB 0 is reserved for Sub2API; DB 1 is reserved for New API.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
SUB2API_REDIS_DB=0
NEW_API_REDIS_DB=1
REDIS_MAXMEMORY=256mb
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=5

# -----------------------------------------------------------------------------
# Sub2API runtime
# -----------------------------------------------------------------------------
SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD=change-me-sub2api-admin-password
SUB2API_JWT_SECRET=change-me-sub2api-jwt-secret-32-bytes-minimum
SUB2API_TOTP_ENCRYPTION_KEY=change-me-sub2api-totp-key-32-bytes-minimum
SUB2API_DB_MAX_OPEN_CONNS=20
SUB2API_DB_MAX_IDLE_CONNS=5
SUB2API_URL_ALLOWLIST_ENABLED=true

# -----------------------------------------------------------------------------
# New API runtime
# -----------------------------------------------------------------------------
NEW_API_SESSION_SECRET=change-me-new-api-session-secret-32-bytes-minimum
NEW_API_CRYPTO_SECRET=change-me-new-api-crypto-secret-32-bytes-minimum
NEW_API_NODE_NAME=new-api-node-1
NEW_API_ERROR_LOG_ENABLED=true
NEW_API_BATCH_UPDATE_ENABLED=true

# -----------------------------------------------------------------------------
# Nginx and TLS
# -----------------------------------------------------------------------------
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=true
CERTBOT_RENEW_INTERVAL_HOURS=12
REQUEST_BODY_SIZE=256m
PROXY_READ_TIMEOUT=3600s
PROXY_SEND_TIMEOUT=3600s

# IP certificate settings. Certbot 5.4+ uses --ip-address and shortlived profile.
IP_CERT_NAME=ip-${SERVER_PUBLIC_IP}
IP_CERT_PREFERRED_PROFILE=shortlived

# Domain certificate settings used after DNS is configured.
DOMAIN_CERT_NAME=ai-api-relay-domains

# -----------------------------------------------------------------------------
# Backup and health reporting
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
HEALTH_PUBLIC_TIMEOUT_SECONDS=10
