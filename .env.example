# Copy to .env, replace every change-me value, and chmod 600.
# Production uses a .env symlink to /etc/vps-infra/secrets/ai-api-relay/.env.

COMPOSE_PROJECT_NAME=ai-api-relay
TZ=Asia/Hong_Kong
# Pinned Linux/amd64 images. Update deliberately after reviewing release notes.
POSTGRES_IMAGE_TAG=16.15-alpine
REDIS_IMAGE_TAG=7.4.11-alpine
SUB2API_IMAGE_TAG=0.2.9
# Latest upstream release is RC.40; last non-RC release is v0.13.2. Keep this
# tag unless v1.0 GA is available or a downgrade has passed compatibility tests.
NEW_API_IMAGE_TAG=v1.0.0-rc.40

POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=320m
SUB2API_MEM_LIMIT=768m
NEW_API_MEM_LIMIT=768m
POSTGRES_CPUS=1.0
REDIS_CPUS=0.5
SUB2API_CPUS=1.0
NEW_API_CPUS=1.0
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser-password
SUB2API_POSTGRES_DB=sub2api
SUB2API_POSTGRES_USER=sub2api
SUB2API_POSTGRES_PASSWORD=change-me-sub2api-postgres-password
NEW_API_POSTGRES_DB=newapi
NEW_API_POSTGRES_USER=newapi
NEW_API_POSTGRES_PASSWORD=change-me-newapi-postgres-password

REDIS_PASSWORD=change-me-redis-password
REDIS_MAXMEMORY=256mb
SUB2API_REDIS_DB=0
NEW_API_REDIS_DB=1
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=5

SUB2API_ADMIN_EMAIL=admin@your-domain.com
SUB2API_ADMIN_PASSWORD=change-me-sub2api-admin-password
SUB2API_JWT_SECRET=change-me-sub2api-jwt-secret-32-bytes-minimum
SUB2API_TOTP_ENCRYPTION_KEY=change-me-sub2api-totp-key-32-bytes-minimum
SUB2API_DB_MAX_OPEN_CONNS=20
SUB2API_DB_MAX_IDLE_CONNS=5
SUB2API_URL_ALLOWLIST_ENABLED=true

NEW_API_SESSION_SECRET=change-me-new-api-session-secret-32-bytes-minimum
NEW_API_CRYPTO_SECRET=change-me-new-api-crypto-secret-32-bytes-minimum
NEW_API_NODE_NAME=new-api-node-1
NEW_API_ERROR_LOG_ENABLED=true
NEW_API_BATCH_UPDATE_ENABLED=true

BACKUP_DIR=/home/alex/backups/ai-api-relay
BACKUP_RETENTION_DAYS=14
