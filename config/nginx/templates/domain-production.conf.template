server {
    listen 80 default_server;
    server_name ${SUB2API_DOMAIN} ${NEW_API_DOMAIN};

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SUB2API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_CERT_NAME}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        include /etc/nginx/snippets/proxy-streaming.conf;
        proxy_pass http://sub2api:8080;
    }
}

server {
    listen 443 ssl http2;
    server_name ${NEW_API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_CERT_NAME}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        include /etc/nginx/snippets/proxy-streaming.conf;
        proxy_pass http://new-api:3000;
    }
}

server {
    listen 18080;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        include /etc/nginx/snippets/proxy-streaming.conf;
        proxy_set_header Host ${SUB2API_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${SUB2API_DOMAIN};
        proxy_set_header X-Forwarded-Port 443;
        proxy_pass http://sub2api:8080;
    }
}
